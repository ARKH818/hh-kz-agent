+) -> None:
+    database = make_database(tmp_path)
+    for owner in (42, 43):
+        assert database.discover(
+            job_id="shared-job",
+            title="Python developer",
+            company="Example",
+            url="https://example.com/vacancy/shared-job",
+            description_hash="hash",
+            search_query="Python",
+            discovered_at=NOW,
+            telegram_user_id=owner,
+        )
+
+    with sqlite3.connect(database.path) as connection:
+        assert connection.execute(
+            "SELECT COUNT(*) FROM vacancies WHERE id = 'shared-job'"
+        ).fetchone()[0] == 1
+        assert connection.execute(
+            "SELECT COUNT(*) FROM user_vacancies WHERE vacancy_id = 'shared-job'"
+        ).fetchone()[0] == 2
+
+    first = database.get("shared-job", telegram_user_id=42)
+    second = database.get("shared-job", telegram_user_id=43)
+    assert first is not None and second is not None
+    assert first.status is VacancyStatus.DISCOVERED
+    assert second.status is VacancyStatus.DISCOVERED
+
+    # One user's rejection must not touch the other user's state.
+    assert database.transition(
+        "shared-job",
+        VacancyStatus.DISCOVERED,
+        VacancyStatus.REJECTED_BY_FILTER,
+        telegram_user_id=42,
+    )
+    assert (
+        database.get("shared-job", telegram_user_id=43).status
+        is VacancyStatus.DISCOVERED
+    )
+
+    # One user's approval request must not touch the other user's state.
+    assert database.request_approval(
+        job_id="shared-job", now=NOW, telegram_user_id=43
+    )
+    assert (
+        database.get("shared-job", telegram_user_id=42).status
+        is VacancyStatus.REJECTED_BY_FILTER
+    )
+    assert (
+        database.get("shared-job", telegram_user_id=43).status
+        is VacancyStatus.PENDING_APPROVAL
+    )
+    assert database.get("shared-job", telegram_user_id=99) is None
