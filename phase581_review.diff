+        """Split legacy vacancy state into shared data + per-user state.
+
+        Phase 5.8.1: one all-or-nothing transaction.  A failure at any step
+        rolls the whole migration back, so a re-run starts from the original
+        schema and cannot produce a half-migrated database.  Foreign keys are
+        disabled only for the table rebuild and restored in ``finally``.
+        """
+        vacancy_columns = {
+            row[1] for row in connection.execute("PRAGMA table_info(vacancies)")
+        }
+        if "status" not in vacancy_columns:
+            return  # already migrated (or a freshly created catalog)
+        user_columns = {
+            row[1] for row in connection.execute("PRAGMA table_info(user_vacancies)")
+        }
+        if "status" in user_columns:
+            raise RuntimeError(
+                "inconsistent vacancy schema: status exists in both "
+                "vacancies and user_vacancies; refusing to guess which "
+                "state is authoritative"
+            )
+
+        connection.execute("PRAGMA foreign_keys = OFF")
+        connection.execute("PRAGMA legacy_alter_table = ON")
+        try:
+            connection.execute("BEGIN IMMEDIATE")
+            try:
+                self._rebuild_vacancy_user_state(connection)
+                violations = connection.execute("PRAGMA foreign_key_check").fetchall()
+                if violations:
+                    raise RuntimeError(
+                        "vacancy migration produced invalid foreign keys: "
+                        f"{tuple(tuple(item) for item in violations[:3])}"
+                    )
+                connection.execute("COMMIT")
+            except BaseException:
+                connection.execute("ROLLBACK")
+                raise
+        finally:
+            connection.execute("PRAGMA legacy_alter_table = OFF")
+            connection.execute("PRAGMA foreign_keys = ON")
