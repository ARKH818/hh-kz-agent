+def test_vacancy_migration_preserves_owned_state_and_quarantines_null_owner(
+    tmp_path: Path,
+) -> None:
+    path = tmp_path / "legacy.db"
+    _make_legacy_vacancy_database(path, with_user_table=True)
+
+    database = Database(path)
+    database.init()
+
+    owned = database.get("owned-job", telegram_user_id=42)
+    assert owned is not None
+    assert owned.status is VacancyStatus.APPROVED
+    assert owned.approver_id == 42
+    assert owned.approval_requested_at == "2026-07-20T10:00:00+00:00"
+    assert owned.approved_at == "2026-07-20T10:01:00+00:00"
+    assert owned.error_text == "owned error"
+    assert database.get("owned-job", telegram_user_id=43) is None
+
+    # An ambiguous NULL-owner row is preserved, but belongs to nobody.
+    assert database.get("unassigned-job", telegram_user_id=42) is None
+    assert database.get("unassigned-job", telegram_user_id=43) is None
+    with sqlite3.connect(path) as connection:
+        assert connection.execute(
+            "SELECT COUNT(*) FROM vacancies"
+        ).fetchone()[0] == 2
+        assert connection.execute(
+            "SELECT COUNT(*) FROM user_vacancies"
+        ).fetchone()[0] == 1
+        assert connection.execute(
+            "SELECT telegram_user_id, error_text "
+            "FROM legacy_unassigned_vacancies WHERE id = 'unassigned-job'"
+        ).fetchone() == (None, "unassigned error")
+
+
+def test_vacancy_migration_is_idempotent(tmp_path: Path) -> None:
+    path = tmp_path / "legacy.db"
+    _make_legacy_vacancy_database(path, with_user_table=False)
+
+    first = Database(path)
+    first.init()
+    with sqlite3.connect(path) as connection:
+        before = (
+            connection.execute("SELECT COUNT(*) FROM vacancies").fetchone()[0],
+            connection.execute("SELECT COUNT(*) FROM user_vacancies").fetchone()[0],
+            connection.execute(
+                "SELECT COUNT(*) FROM legacy_unassigned_vacancies"
+            ).fetchone()[0],
+        )
+
+    second = Database(path)
+    second.init()
+    with sqlite3.connect(path) as connection:
+        after = (
+            connection.execute("SELECT COUNT(*) FROM vacancies").fetchone()[0],
+            connection.execute("SELECT COUNT(*) FROM user_vacancies").fetchone()[0],
+            connection.execute(
+                "SELECT COUNT(*) FROM legacy_unassigned_vacancies"
+            ).fetchone()[0],
+        )
+
+    assert before == after == (2, 1, 1)
+    assert second.get("owned-job", telegram_user_id=42) is not None
+
+
+def test_vacancy_migration_rolls_back_and_can_be_retried(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    path = tmp_path / "legacy.db"
+    _make_legacy_vacancy_database(path, with_user_table=True)
+
+    def exploding_rebuild(self: Database, connection: sqlite3.Connection) -> None:
+        connection.execute("CREATE TABLE migration_failure_probe (value INTEGER)")
+        raise RuntimeError("migration exploded")
+
+    monkeypatch.setattr(
+        Database, "_rebuild_vacancy_user_state", exploding_rebuild
+    )
+    with pytest.raises(RuntimeError, match="migration exploded"):
+        Database(path).init()
+
+    with sqlite3.connect(path) as connection:
+        tables = {
+            row[0]
+            for row in connection.execute(
+                "SELECT name FROM sqlite_master WHERE type = 'table'"
+            )
+        }
+        assert "migration_failure_probe" not in tables
+        assert "status" in {
+            row[1] for row in connection.execute("PRAGMA table_info(vacancies)")
+        }
+
+    # The failed run left the database recoverable: a clean retry succeeds.
+    monkeypatch.undo()
+    recovered = Database(path)
+    recovered.init()
+    assert (
+        recovered.get("owned-job", telegram_user_id=42).status
+        is VacancyStatus.APPROVED
+    )
