+                discovered_at TEXT NOT NULL,
+                approval_requested_at TEXT,
+                approval_expires_at TEXT,
+                approved_at TEXT,
+                applying_at TEXT,
+                submit_attempted_at TEXT,
+                applied_at TEXT,
+                approver_id INTEGER,
+                permit_hash TEXT,
+                error_text TEXT NOT NULL DEFAULT '',
+                cover_letter TEXT NOT NULL DEFAULT ''
+            )
