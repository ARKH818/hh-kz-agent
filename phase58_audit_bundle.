_SESSION_CLEANUP_COMPONENTS = (
    "dom_storage",
    "indexeddb",
    "cachestorage",
    "service_worker",
)

# Executed only on a verified https://hh.kz origin.  Each step reports its
# own outcome so a partial failure can never be reported as a clean logout.
_SESSION_CLEANUP_SCRIPT = """
(async () => {
  const result = {
    dom_storage: false,
    indexeddb: false,
    cachestorage: false,
    service_worker: false
  };
  try {
    localStorage.clear();
    sessionStorage.clear();
    result.dom_storage = true;
  } catch (error) {}
  try {
    const databases = await indexedDB.databases();
    await Promise.all(databases.map((info) => new Promise((resolve, reject) => {
      const request = indexedDB.deleteDatabase(info.name);
      request.onsuccess = () => resolve();
      request.onerror = () => reject(request.error);
      request.onblocked = () => reject(new Error("blocked"));
    })));
    result.indexeddb = true;
  } catch (error) {}
  try {
    const keys = await caches.keys();
    const deleted = await Promise.all(keys.map((key) => caches.delete(key)));
    // CacheStorage.delete() resolves false when the cache still exists.
    result.cachestorage = deleted.every((ok) => ok === true);
  } catch (error) {}
  try {
    if (navigator.serviceWorker) {
      const registrations = await navigator.serviceWorker.getRegistrations();
      const unregistered = await Promise.all(
        registrations.map((item) => item.unregister())
      );
      // A false result means the registration was not removed.
      result.service_worker = unregistered.every((ok) => ok === true);
    } else {
      result.service_worker = true;
    }
  } catch (error) {}
  return result;
})()
"""


@dataclass(frozen=True)
class SessionCleanupReport:
    """Per-component result of an HH-origin session data cleanup."""

    cookies: bool
    dom_storage: bool
    indexeddb: bool
    cachestorage: bool
    service_worker: bool

    @property
    def ok(self) -> bool:
        return all(
            (
                self.cookies,
                self.dom_storage,
                self.indexeddb,
                self.cachestorage,
                self.service_worker,
            )
        )

    @property
    def failed(self) -> tuple[str, ...]:
        return tuple(
            name
            for name in _SESSION_CLEANUP_COMPONENTS
            if not getattr(self, name)
        ) + (() if self.cookies else ("cookies",))


def _utc_iso(value: datetime) -> str:
    """Return an ISO-8601 UTC timestamp for persisted account state."""
    if value.tzinfo is None:
        value = value.replace(tzinfo=UTC)
    return value.astimezone(UTC).isoformat()


def _page_url(page: Any) -> str:
    """Read the current page URL without trusting a specific page class."""
    try:
        value = getattr(page, "url", "")
        if callable(value):
            value = value()
        return str(value or "")
    except Exception:
        return ""


def _is_hh_origin(url: str) -> bool:
    """True only for https://hh.kz[:443] or https://www.hh.kz[:443].

    Any other scheme, host, port or embedded credentials are rejected.
    Malformed URLs return False instead of raising.
    """
    try:
        parsed = urlparse(url)
        if parsed.scheme.casefold() != "https":
            return False
        if parsed.hostname not in {"hh.kz", "www.hh.kz"}:
            return False
        if parsed.username is not None or parsed.password is not None:
            return False
        port = parsed.port
        return port is None or port == 443
    except (AttributeError, TypeError, ValueError):
        return False


def _is_login_url(url: str) -> bool:
    parsed = urlparse(url)
    path = parsed.path.casefold()
    return any(
        fragment in path
        for fragment in ("/account/login", "/logon", "/auth/login", "/auth/")
    )


def _is_hh_url(url: str) -> bool:
    hostname = (urlparse(url).hostname or "").casefold()
    return hostname == "hh.kz" or hostname.endswith(".hh.kz") or (
        hostname == "hh.ru" or hostname.endswith(".hh.ru")
    )


def _is_applicant_url(url: str) -> bool:
    """True only for an authenticated-area URL on an HH host."""
    if not _is_hh_url(url) or _is_login_url(url):
        return False
    return urlparse(url).path.casefold().startswith("/applicant")


async def _any_visible(page: Any, selectors: tuple[str, ...]) -> bool:
    """Return True when at least one selector is currently visible."""
    for selector in selectors:
        try:
            if await page.locator(selector).first.is_visible():
                return True
        except Exception as exc:
            logger.debug(
                "hh_login_selector_check_failed selector=%s error=%s",
                selector,
                type(exc).__name__,
            )
    return False


async def _console_manual_login_prompt(message: str) -> None:
