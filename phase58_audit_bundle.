logger = logging.getLogger(__name__)
PRIVATE_REPLY = "This bot is private."
NO_RUNTIME_REPLY = "Agent runtime is not running for your account."


class TelegramService:
    def __init__(
        self,
        settings: Settings,
        database: Database,
        approval_service: ApprovalService,
        contexts: dict[int, UserRuntimeContext] | None = None,
        *,
        bot: Any | None = None,
        dispatcher: Dispatcher | None = None,
        now_factory: Callable[[], datetime] | None = None,
        hh_client: HHClient | None = None,
        hh_clients: dict[int, HHClient] | None = None,
    ):
        self.settings = settings
        self.database = database
        self.approval_service = approval_service
        self._contexts: dict[int, UserRuntimeContext] = (
            contexts if contexts is not None else {}
        )
        self.bot = bot or Bot(token=settings.tg_bot_token)
        self.dispatcher = dispatcher or Dispatcher()
        self.now_factory = now_factory or (lambda: datetime.now().astimezone())
        self._captcha_futures: dict[int, asyncio.Future[str | None]] = {}
        self.latest_release: ReleaseInfo | None = None
        self._notified_release_tag: str | None = None
        # Phase 5.6: clients are keyed by their verified Telegram user id,
        # so a command can never reach another user's HH session.
        self._hh_clients: dict[int, HHClient] = dict(hh_clients or {})
        if hh_client is not None:
            self._hh_clients[hh_client.telegram_user_id] = hh_client
        self._register_handlers()

    def authorized(self, user_id: int) -> bool:
        user = self.database.get_user(user_id)
        return user is not None and user["is_active"] == 1

    def _runtime_context(self, user_id: int) -> UserRuntimeContext | None:
        context = self._contexts.get(user_id)
        if context is None:
            return None
        # Phase 5.6: a context stored under a foreign id must never be
        # controlled by that id.
        if context.telegram_user_id != user_id:
            logger.error("runtime_context_identity_rejected user=%s", user_id)
            return None
        return context

    def _hh_client_for(self, user_id: int) -> HHClient | None:
        client = self._hh_clients.get(user_id)
        if client is None:
            return None
        if client.telegram_user_id != user_id:
            logger.error("hh_client_identity_rejected user=%s", user_id)
            return None
        return client

    async def command_async(
        self,
        name: str,
        user_id: int,
        *,
        username: str | None = None,
        first_name: str | None = None,
    ) -> str:
        """Async command entry point used by the Telegram handler."""
        if name in {"logout", "resume"}:
            try:
                if name == "logout":
                    return await self._logout(user_id)
                return await self._resume(user_id)
            except asyncio.CancelledError:
                raise
            except Exception as exc:
                # A session check error is contained here: it must never
                # kill Telegram polling and it is never shown verbatim.
                logger.warning(
                    "hh_command_failed command=%s user=%s error=%s",
                    name,
                    user_id,
                    type(exc).__name__,
                )
                return (
                    "HH.kz session state could not be confirmed. "
                    "Please try again."
                )
        return self.command(
            name, user_id, username=username, first_name=first_name
        )

    async def _logout(self, user_id: int) -> str:
        context = self._runtime_context(user_id)
        if context is None:
            return NO_RUNTIME_REPLY
        client = self._hh_client_for(user_id)
        if client is None:
            return "HH session manager is not available."
        result = await client.logout()
        if result.ok:
            context.auth_state = LoginState.NOT_AUTHORIZED.value
            context.auth_paused = True
            context.auth_reason = HHAccountStatus.LOGGED_OUT.value
            return "HH.kz logout confirmed. Session closed."
        if result.reason in {"no_account", "ownership"}:
            # The session cannot be owned/verified by this caller.  Keep the
            # runtime closed instead of relying on the caller's stale state.
            context.auth_state = LoginState.CHECK_FAILED.value
            context.auth_paused = True
            context.auth_reason = "session_check_unconfirmed"
            if result.reason == "no_account":
                return "HH account is not configured for your Telegram user."
            return "HH account ownership could not be verified."
        if result.state is LoginState.AUTHORIZED:
            return "HH.kz logout was not confirmed: the session is still active."
        # The session invalidation itself failed, or the post-logout probe
        # was inconclusive.  Keep the runtime gate closed even though the
        # logout cannot be claimed as confirmed.
        context.auth_state = result.state.value
        context.auth_paused = True
        context.auth_reason = "session_check_unconfirmed"
        return "HH.kz session state could not be confirmed after logout."

    async def _resume(self, user_id: int) -> str:
        context = self._runtime_context(user_id)
        if context is None:
            return NO_RUNTIME_REPLY
        client = self._hh_client_for(user_id)
        if client is None:
            # Fail closed.  Without a verified HHClient there is no way to
            # obtain LoginState.AUTHORIZED, so no runtime or auth state may
            # be changed.  The former legacy fallback is deliberately gone.
            return "HH session manager is not available."
        state = await client.check_session()
        if state is LoginState.AUTHORIZED:
            context.auth_state = LoginState.AUTHORIZED.value
            context.auth_paused = False
            context.auth_reason = ""
            context.paused = False
            context.circuit_reason = ""
            context.consecutive_search_errors = 0
            context.next_run_at = None
            context.wake_event.set()
            logger.info("agent_resumed user=%s", user_id)
            return "Agent resumed."
        context.auth_state = state.value
        if state in {LoginState.UNKNOWN, LoginState.CHECK_FAILED}:
            # Do not clear an existing auth pause and do not claim expiry.
            if context.auth_paused:
                context.auth_reason = "session_check_unconfirmed"
            return (
                "HH.kz session state could not be confirmed. "
                "Please try /resume again."
            )
        context.auth_paused = True
        context.auth_reason = state.value
        return (
            "HH.kz authorization is required. "
            "Sign in and then use /resume again."
        )

    def command(
        self,
        name: str,
        user_id: int,
        *,
        username: str | None = None,
        first_name: str | None = None,
    ) -> str:
        if name == "start":
            now = self.now_factory()
            self.database.get_or_create_user(
                telegram_user_id=user_id,
                username=username,
                first_name=first_name,
                now=now,
            )
            self.database.get_or_create_hh_account(
                telegram_user_id=user_id,
                now=now,
            )
            if self.authorized(user_id):
                return "Welcome back! HH.kz Agent is ready."
            return "Welcome! You are now registered with HH.kz Agent."
        if not self.authorized(user_id):
            return PRIVATE_REPLY
        if name == "pause":
            context = self._runtime_context(user_id)
            if context is None:
                return NO_RUNTIME_REPLY
            context.paused = True
            context.next_run_at = None
            logger.info("agent_paused user=%s", user_id)
            return "Agent paused."
        if name == "resume":
            context = self._runtime_context(user_id)
            if context is None:
                return NO_RUNTIME_REPLY
            # A synchronous caller cannot perform a real session check.  It
            # must therefore fail closed unless an identity-verified client
            # is registered and an AUTHORIZED result is already cached.
            # auth_paused is never cleared here: only _resume() may clear it,
            # and only after client.check_session() returned AUTHORIZED.
            client = self._hh_client_for(user_id)
            if client is None:
                return "HH session manager is not available."
            if (
                context.auth_paused
                or context.auth_state != HHAccountStatus.AUTHORIZED.value
            ):
                return "HH.kz session is not confirmed. Use /resume again."
            context.paused = False
            context.circuit_reason = ""
            context.consecutive_search_errors = 0
            context.next_run_at = None
            context.wake_event.set()
            logger.info("agent_resumed user=%s", user_id)
            return "Agent resumed."
        if name == "logout":
            # The Telegram handler always uses command_async(); this reply
            # only covers direct synchronous callers.
            return "Use the asynchronous /logout handler."
        if name == "status":
            context = self._runtime_context(user_id)
            if context is None:
                return NO_RUNTIME_REPLY
            stats = self.database.stats(telegram_user_id=user_id)
            processed = sum(stats.values())
            version_str = f"v{__version__}"
            if self.latest_release is not None:
                version_str += f" (доступно обновление {self.latest_release.tag_name})"
            # Stage 4\6: the mode shown is the calling user's own setting.
            user_mode = (
                context.user_settings.app_mode
                if context is not None
                else self.settings.user_defaults.app_mode
            )
            return (
                "версия: " + version_str + "\n"
                "mode: " + user_mode + "\n"
                "state: " + ("paused" if context.paused else "running") + "\n"
                "hh auth: " + context.auth_state + "\n"
                "processed: " + str(processed) + "\n"
                "applied today: " + str(self.database.applied_today(self.now_factory(), telegram_user_id=user_id))
            )
        if name == "pending":
            pending = self.database.pending(telegram_user_id=user_id)
            return (
                "No pending vacancies."
                if not pending
                else "\n".join(f"{item.id}: {item.title}" for item in pending)
            )
        if name == "stats":
            return "\n".join(
                f"{status}: {count}"
                for status, count in self.database.stats(telegram_user_id=user_id).items()
                if count
            ) or "No vacancies recorded."
        if name == "diagnostics":
            return self._diagnostics(user_id)
        if name == "cancel":
            future = self._captcha_futures.get(user_id)
            if future is not None and not future.done():
                future.set_result(None)
            return "Current input request cancelled."
        return "Unknown command."

    def _diagnostics(self, user_id: int) -> str:
        context = self._runtime_context(user_id)
        version_str = f"v{__version__}"
        if self.latest_release is not None:
            version_str += f" (доступно: {self.latest_release.tag_name})"
        if context is None:
            return (
                "версия: " + version_str + "\n"
                "runtime not running"
            )
        run = self.database.latest_search_run(telegram_user_id=user_id)
        if run is None:
            return "версия: " + version_str + "\nNo search diagnostics recorded."
        started = datetime.fromisoformat(run.started_at)
        finished = datetime.fromisoformat(run.finished_at)
        reasons = ", ".join(
            f"{reason}={count}"
            for reason, count in sorted(run.rejection_reasons.items())
        ) or "нет"
        errors = ", ".join(
            f"{reason}={count}"
            for reason, count in sorted(run.error_reasons.items())
        ) or "нет"
        breaker = (
            f"open ({context.circuit_reason})"
            if context.circuit_reason
            else "closed"
        )
        if context.paused:
            next_run = "paused"
        elif context.next_run_at is None:
            next_run = "после текущего цикла"
        else:
            next_run = context.next_run_at.astimezone().strftime(
                "%Y-%m-%d %H:%M:%S"
            )
        return (
            "версия: " + version_str + "\n"
            "последний цикл: " + started.astimezone().strftime("%Y-%m-%d %H:%M:%S") + "\n"
            "состояние: " + run.state + "\n"
            "длительность: " + str(int((finished - started).total_seconds())) + " с\n"
            "запросы: " + str(run.query_count) + "\n"
            "найдено: " + str(run.found_results) + "\n"
            "новые: " + str(run.new_vacancies) + "\n"
            "дубли: " + str(run.duplicates) + "\n"
            "отклонено — фильтр: " + str(run.rejected_by_filter) + "\n"
            "причины: " + reasons + "\n"
            "карточки: " + str(run.telegram_cards) + "\n"
            "ошибки: " + str(run.error_count) + " (" + errors + ")\n"
            "последняя ошибка: " + (run.last_safe_error or "нет") + "\n"
            "breaker: " + breaker + "\n"
            "hh auth: " + context.auth_state + (
                " (paused)" if context.auth_paused else ""
            ) + "\n"
            "last breaker: " + (run.circuit_reason or "none") + "\n"
            "следующий запуск: " + next_run
        )
    def _register_handlers(self) -> None:
        for name in (
            "start",
            "status",
            "pause",
            "resume",
            "logout",
            "pending",
            "stats",
            "diagnostics",
            "cancel",
        ):
            self.dispatcher.message.register(self._command_handler, Command(name))
        self.dispatcher.callback_query.register(
            self._callback_handler,
            F.data.startswith("apply:") | F.data.startswith("skip:"),
        )
        self.dispatcher.message.register(self._text_handler)

    async def _command_handler(self, message: Message) -> None:
        name = (message.text or "").split()[0].lstrip("/").split("@")[0]
        user_id = message.from_user.id
        # /start is allowed for unauthorized users to enable registration
        if name == "start":
            username = message.from_user.username
            first_name = message.from_user.first_name
            await message.answer(
                self.command(name, user_id, username=username, first_name=first_name)
            )
            return
        if not self.authorized(user_id):
            await message.answer(PRIVATE_REPLY)
            return
        await message.answer(await self.command_async(name, user_id))

    async def _callback_handler(self, callback: CallbackQuery) -> None:
        user_id = callback.from_user.id
        if not self.authorized(user_id):
            await self._answer_callback(callback, PRIVATE_REPLY, show_alert=True)
            return
        # An approval callback must reach the same user's runtime and HH
        # session.  Checking only database membership would let a different
        # active user drive this process's fixed approval service/sender.
        client = self._hh_client_for(user_id)
        sender = getattr(self.approval_service, "sender", None)
        if (
            self._runtime_context(user_id) is None
            or client is None
            or (
                sender is not client
                and getattr(sender, "telegram_user_id", None) != user_id
            )
        ):
            logger.error("approval_callback_identity_rejected user=%s", user_id)
            await self._answer_callback(callback, NO_RUNTIME_REPLY, show_alert=True)
            return
        action, separator, job_id = (callback.data or "").partition(":")
        if len((callback.data or "").encode()) > 64:
            await self._answer_callback(
                callback, "Некорректное действие.", show_alert=True
            )
            return
        if not separator or action not in {"apply", "skip"} or not job_id:
            await self._answer_callback(
                callback, "Некорректное действие.", show_alert=True
            )
            return
        if action == "apply":
            await callback.answer("⏳ Отправляем отклик...", show_alert=False)
            result = await self.approval_service.approve_and_apply(job_id, user_id)
            vacancy = self.database.get(job_id, telegram_user_id=user_id)
            if result.ok:
                await self.notify("✓ Отклик отправлен", user_id)
                if callback.message:
                    await callback.message.edit_reply_markup(reply_markup=None)
            else:
                if vacancy and vacancy.error_text == "questionnaire_required":
                    await self.notify_questionnaire_required(
                        vacancy.title, vacancy.url, user_id
                    )
                    if callback.message:
                        await callback.message.edit_reply_markup(reply_markup=None)
                else:
                    await self.notify(f"✗ {result.message}", user_id)
        else:
            result = self.approval_service.skip(job_id, user_id)
            await self._answer_callback(
                callback, result.message, show_alert=not result.ok
            )
            if result.ok and callback.message:
                await callback.message.edit_reply_markup(reply_markup=None)

    @staticmethod
    async def _answer_callback(
        callback: CallbackQuery, text: str, *, show_alert: bool = False
    ) -> None:
        try:
            await callback.answer(text, show_alert=show_alert)
        except TelegramAPIError:
            logger.warning("telegram_callback_answer_failed")

    async def _text_handler(self, message: Message) -> None:
        if not self.authorized(message.from_user.id):
            await message.answer(PRIVATE_REPLY)
            return
        text = message.text
        if text is None or text.startswith("/"):
            return
        future = self._captcha_futures.get(message.from_user.id)
        if future is not None and not future.done():
            future.set_result(text.strip())
            await message.answer("CAPTCHA input received.")
            return

    def _rich_card(self, vacancy: Vacancy) -> InputRichMessage:
        def value(name: str, default: str) -> str:
            result = getattr(vacancy, name, "")
            return result.strip() if isinstance(result, str) and result.strip() else default

        blocks = [
            InputRichBlockParagraph(
                text=vacancy.title,
            ),
            InputRichBlockParagraph(
                text=RichTextUrl(
                    text=RichTextBold(
                        text="Открыть вакансию",
                    ),
                    url=vacancy.url,
                ),
            ),
            InputRichBlockDivider(),
            InputRichBlockSectionHeading(
                text="Компания",
                size=1,
            ),
            InputRichBlockDetails(
                summary="Компания",
                blocks=[
                    InputRichBlockParagraph(
                        text=f"Компания: {vacancy.company}",
                    ),
                ],
            ),
            InputRichBlockDetails(
