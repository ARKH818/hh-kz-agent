    def create_user(
        self,
        telegram_user_id: int,
        username: str | None = None,
        first_name: str | None = None,
        now: datetime | None = None,
    ) -> bool:
        timestamp = _iso(now or datetime.now(UTC))

        with self._connect() as connection:
            cursor = connection.execute(
                """
                INSERT OR IGNORE INTO users (
                    telegram_user_id,
                    username,
                    first_name,
                    created_at,
                    is_active
                )
                VALUES (?, ?, ?, ?, 1)
                """,
                (
                    telegram_user_id,
                    username,
                    first_name,
                    timestamp,
                ),
            )

        return cursor.rowcount > 0

    def get_user(self, telegram_user_id: int) -> sqlite3.Row | None:
        with self._connect() as connection:
            return connection.execute(
                """
                SELECT
                    telegram_user_id,
                    username,
                    first_name,
                    created_at,
                    is_active
                FROM users
                WHERE telegram_user_id = ?
                """,
                (telegram_user_id,),
            ).fetchone()

    def update_user(
        self,
        telegram_user_id: int,
        username: str | None = None,
        first_name: str | None = None,
    ) -> bool:
        with self._connect() as connection:
            cursor = connection.execute(
                """
                UPDATE users
                SET username = ?,
                    first_name = ?
                WHERE telegram_user_id = ?
                """,
                (
                    username,
                    first_name,
                    telegram_user_id,
                ),
            )

        return cursor.rowcount > 0

    def set_user_active(
        self,
        telegram_user_id: int,
        active: bool,
    ) -> bool:
        with self._connect() as connection:
            cursor = connection.execute(
                """
                UPDATE users
                SET is_active = ?
                WHERE telegram_user_id = ?
                """,
                (
                    1 if active else 0,
                    telegram_user_id,
                ),
            )

        return cursor.rowcount > 0

    def get_active_users(self) -> list[sqlite3.Row]:
        with self._connect() as connection:
            return connection.execute(
                """
                SELECT
                    telegram_user_id,
                    username,
                    first_name,
                    created_at,
                    is_active
                FROM users
                WHERE is_active = 1
                ORDER BY created_at
                """
            ).fetchall()

    def get_or_create_user(
        self,
        telegram_user_id: int,
        username: str | None = None,
        first_name: str | None = None,
        now: datetime | None = None,
    ) -> sqlite3.Row:
        user = self.get_user(telegram_user_id)

        if user is None:
            self.create_user(
                telegram_user_id=telegram_user_id,
                username=username,
                first_name=first_name,
                now=now,
            )
        else:
            self.update_user(
                telegram_user_id=telegram_user_id,
                username=username,
                first_name=first_name,
            )

        result = self.get_user(telegram_user_id)
        if result is None:
            raise RuntimeError("user could not be created or loaded")

        return result

