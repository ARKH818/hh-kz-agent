def _install_account_run_fakes(
    monkeypatch,
    calls: dict,
    *,
    login_error: Exception | None = None,
    login_result: bool = True,
    agent_error: Exception | None = None,
    events: list[str] | None = None,
) -> list[_AccountFakeBackend]:
    """Install fakes for run(): no real browser, Telegram or HH client."""
    backends: list[_AccountFakeBackend] = []

    def fake_create_browser_backend(settings_arg, profile_dir=None):
        if events is not None:
            events.append("backend_created")
        calls.setdefault("factory_calls", []).append(
            (settings_arg, profile_dir)
        )
        backend = _AccountFakeBackend()
        backends.append(backend)
        return backend

    class FakeHHClient:
        def __init__(
            self,
            browser_context,
            settings_arg,
            database_arg,
            approval_guard,
            telegram_user_id,
            *,
            user_settings=None,
            hh_account=None,
            session_lock=None,
            session_checker=None,
        ):
            calls["hh_client_session_lock"] = session_lock
            self.session_lock = session_lock
            self.session_checker = session_checker
            self.telegram_user_id = telegram_user_id
            self.user_settings = user_settings
            self.hh_account = hh_account
            calls["hh_client_approval_guard"] = approval_guard
            calls["hh_client_telegram_user_id"] = telegram_user_id
            calls["hh_client_browser_context"] = browser_context
            calls["hh_client_user_settings"] = user_settings
            calls["hh_client_hh_account"] = hh_account

        async def ensure_login(self):
            calls["ensure_login"] = True
            if events is not None:
                events.append("login_checked")
            if login_error is not None:
                raise login_error
            return login_result

        async def check_session(self):
            return LoginState.AUTHORIZED

    class FakeTelegramService:
        def __init__(
            self,
            settings_arg,
            database_arg,
            approval_service,
            contexts,
            **kwargs,
        ):
            calls["telegram_contexts"] = contexts
            calls["telegram_hh_client"] = kwargs.get("hh_client")

        async def start_polling(self):
            calls["started_polling"] = True

        async def stop(self):
            calls["stopped_telegram"] = True

    async def fake_agent_loop(context, hh_client, telegram):
        calls["agent_loop_user_id"] = context.telegram_user_id
        if events is not None:
            events.append("agent_loop_started")
        if agent_error is not None:
            raise agent_error

    async def fake_session_watchdog(context, hh_client, telegram):
        # Production watchdog runs forever; these run() tests only check
        # startup/wiring/cleanup and must terminate deterministically.
        calls["session_watchdog_started"] = True
        return None

    monkeypatch.setattr(
        main_module, "create_browser_backend", fake_create_browser_backend
    )
    monkeypatch.setattr(main_module, "HHClient", FakeHHClient)
    monkeypatch.setattr(main_module, "TelegramService", FakeTelegramService)
    monkeypatch.setattr(main_module, "agent_loop", fake_agent_loop)
    monkeypatch.setattr(main_module, "session_watchdog", fake_session_watchdog)

    original_create_runtime_context = main_module.create_runtime_context

    def recording_create_runtime_context(*args, **kwargs):
        if events is not None:
            events.append("context_created")
        return original_create_runtime_context(*args, **kwargs)

