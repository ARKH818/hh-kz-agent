@dataclass(frozen=True)
class VacancyProcessResult:
    outcome: str
    reason: str = ""
    page_state: PageState | None = None


@dataclass
class SearchRunStats:
    query_count: int = 0
    found_results: int = 0
    new_vacancies: int = 0
    duplicates: int = 0
    rejected_by_filter: int = 0
    telegram_cards: int = 0
    error_count: int = 0
    rejection_reasons: Counter[str] = field(default_factory=Counter)
    error_reasons: Counter[str] = field(default_factory=Counter)
    last_safe_error: str = ""
    read_attempts: int = 0
    technical_failures: int = 0
    consecutive_page_errors: int = 0

    def record_error(self, reason: str) -> None:
        self.error_count += 1
        self.error_reasons[reason] += 1
        self.last_safe_error = reason

    def record(self, result: VacancyProcessResult) -> None:
        if result.outcome == "rejected_by_filter":
            self.rejected_by_filter += 1
            self.rejection_reasons[result.reason or "filter_rejected"] += 1
        elif result.outcome == "telegram_card":
            self.telegram_cards += 1
        elif result.outcome == "other_error":
            self.record_error(result.reason or "other_error")

        if result.page_state is None:
            return
        self.read_attempts += 1
        if result.page_state is PageState.PAGE_STRUCTURE_CHANGED:
            self.consecutive_page_errors += 1
        else:
            self.consecutive_page_errors = 0
        if result.page_state in {
            PageState.ACCESS_DENIED,
            PageState.CAPTCHA_DETECTED,
            PageState.NETWORK_ERROR,
        }:
            self.technical_failures += 1

    def circuit_reason(self, settings: Settings) -> str:
        if self.consecutive_page_errors >= settings.circuit_breaker_page_errors:
            return "page_structure_changed"
        if (
            self.read_attempts >= settings.circuit_breaker_min_sample
            and self.technical_failures / self.read_attempts
            >= settings.circuit_breaker_unknown_ratio
        ):
            return "technical_failure_ratio"
        return ""


async def process_vacancy(
    context: UserRuntimeContext,
    hh_client: HHClient,
    telegram: TelegramService,
    summary: VacancySummary,
    *,
    now_factory: Callable[[], datetime] | None = None,
) -> VacancyProcessResult:
    target_user_id = context.telegram_user_id
    # Stage 4\6: user-specific behaviour comes from the per-user
    # configuration owned by this runtime context.
    settings = context.user_settings
    database = context.database
    clock = now_factory or (lambda: datetime.now(UTC))
    now = clock()
    existing = database.get(summary.id, telegram_user_id=target_user_id)
    if summary.previously_sent:
        if existing is None or existing.status is not VacancyStatus.PENDING_APPROVAL:
            return VacancyProcessResult("ignored")
        try:
            await telegram.send_preview(existing, include_actions=True, telegram_user_id=target_user_id)
        except TelegramAPIError:
            return VacancyProcessResult("other_error", "telegram_error")
        return VacancyProcessResult("telegram_card")
    if existing is not None and existing.status is not VacancyStatus.DISCOVERED:
        return VacancyProcessResult("ignored")
    details = await hh_client.read_vacancy(summary, telegram.request_captcha)
    description_hash = (
        hashlib.sha256(details.description.encode()).hexdigest()
        if details.description
        else ""
    )
    if existing is None:
        if not database.discover(
            job_id=summary.id,
            title=summary.title,
            company=details.company,
            company_url=details.company_url,
            url=summary.url,
            description_hash=description_hash,
            search_query=summary.search_query,
            discovered_at=now,
            telegram_user_id=target_user_id,
        ):
            return VacancyProcessResult("ignored")
        logger.info("vacancy_discovered job_id=%s", summary.id)
    else:
        logger.info("vacancy_resumed job_id=%s", summary.id)
    if details.state is not PageState.VACANCY_LOADED:
        error = details.error or details.state.value
        database.transition(
            summary.id,
            VacancyStatus.DISCOVERED,
            VacancyStatus.APPLY_FAILED,
            telegram_user_id=target_user_id,
            error_text=error,
        )
        if details.state is PageState.CAPTCHA_DETECTED:
            await telegram.notify(f"CAPTCHA was not completed for vacancy {summary.id}.", telegram_user_id=target_user_id)
        logger.error("vacancy_read_failed job_id=%s state=%s", summary.id, details.state.value)
        return VacancyProcessResult("other_error", details.state.value, details.state)

    rejection = title_rejection_reason(
        summary.title, settings.profile.candidate.excluded_positions
    )
    if rejection:
        database.transition(
            summary.id,
            VacancyStatus.DISCOVERED,
            VacancyStatus.REJECTED_BY_FILTER,
            telegram_user_id=target_user_id,
            reason=f"Title matched excluded term: {rejection}",
        )
        logger.info("vacancy_rejected job_id=%s source=filter", summary.id)
        return VacancyProcessResult(
            "rejected_by_filter", rejection, PageState.VACANCY_LOADED
        )

    company = await hh_client.read_company_details(details.company_url)
    database.store_company_details(
        summary.id,
        rating=company.rating,
        reviews_count=company.reviews_count,
        telegram_user_id=target_user_id,
    )
    database.store_vacancy_details(
        summary.id,
        salary=details.salary,
        schedule=details.schedule,
        location=details.location,
        experience=details.experience,
        telegram_user_id=target_user_id,
    )

    include_actions = settings.app_mode != "dry_run"

    if settings.app_mode == "dry_run":
        database.transition(
            summary.id,
            VacancyStatus.DISCOVERED,
            VacancyStatus.PREVIEWED,
            telegram_user_id=target_user_id,
        )
    else:
        if not database.request_approval(
            job_id=summary.id,
            now=now,
            telegram_user_id=target_user_id,
        ):
            return VacancyProcessResult(
                "other_error",
                "approval_transition_failed",
                PageState.VACANCY_LOADED,
            )

    try:
        await telegram.send_preview(
            database.get(summary.id, telegram_user_id=target_user_id),
            include_actions=include_actions,
            telegram_user_id=target_user_id,
        )
    except TelegramAPIError:
        return VacancyProcessResult(
            "other_error",
            "telegram_error",
            PageState.VACANCY_LOADED,
        )

    return VacancyProcessResult(
        "telegram_card",
        page_state=PageState.VACANCY_LOADED,
    )


async def run_search_cycle(
    context: UserRuntimeContext,
    hh_client: HHClient,
    telegram: TelegramService,
    *,
    now_factory: Callable[[], datetime] | None = None,
) -> SearchRun:
    target_user_id = context.telegram_user_id
    # Stage 4\6: user-specific behaviour comes from the per-user
    # configuration owned by this runtime context.
    user_settings = context.user_settings
    # Stage 4\7: circuit breaker thresholds are process-level settings,
    # not per-user.  They live in the global Settings object.
    global_settings = context.settings
    database = context.database
    now = now_factory or (lambda: datetime.now(UTC))
    started_at = now()
    stats = SearchRunStats()
    handled_ids: set[str] = set()
    state = "completed"
    circuit_reason = ""
    failure: Exception | None = None
    logger.info(
        "search_cycle_started queries=%s", len(user_settings.profile.hh.search_queries)
    )

    async def process(summary: VacancySummary) -> None:
        nonlocal circuit_reason, state
        if summary.id in handled_ids:
            return
        handled_ids.add(summary.id)
        result = await process_vacancy(
            context,
            hh_client,
            telegram,
            summary,
            now_factory=now,
        )
        stats.record(result)
        circuit_reason = stats.circuit_reason(global_settings)
        if circuit_reason:
            state = "paused_by_circuit_breaker"
            context.paused = True
            context.circuit_reason = circuit_reason

    try:
        database.expire_approved(now(), telegram_user_id=target_user_id)
        for vacancy in database.unprocessed_discovered(telegram_user_id=target_user_id):
            if context.paused:
                break
            await process(
                VacancySummary(
                    vacancy.id,
                    vacancy.title,
                    vacancy.url,
                    vacancy.search_query,
                )
            )
        for query in user_settings.profile.hh.search_queries:
            if context.paused:
                break
            logger.info("search_query_started query=%r", query)

            search = await hh_client.search_vacancies(
                query,
                user_settings.profile.hh.areas,
                user_settings.profile.hh.experience_filters,
            )
            stats.query_count += 1
            stats.found_results += search.found_results
            stats.new_vacancies += sum(
                not summary.previously_sent for summary in search.summaries
            )
            stats.duplicates += search.duplicates
            logger.info(
                "search_query_finished query=%r found=%s new=%s duplicates=%s",
                query,
                search.found_results,
                sum(not summary.previously_sent for summary in search.summaries),
                search.duplicates,
            )
            if search.error_reason:
                stats.record_error(search.error_reason)
                context.consecutive_search_errors += 1
            else:
                context.consecutive_search_errors = 0
            if (
                context.consecutive_search_errors
                >= global_settings.circuit_breaker_page_errors
            ):
                circuit_reason = "search_errors"
                state = "paused_by_circuit_breaker"
                context.paused = True
                context.circuit_reason = circuit_reason
            for summary in search.summaries:
                if context.paused:
                    break
                await process(summary)
        if not context.paused:
            await hh_client.check_messages(telegram.notify)
    except Exception as exc:
        state = "failed"
        stats.record_error(type(exc).__name__)
        failure = exc

    if circuit_reason:
        notification = (
            f"Поиск приостановлен: {circuit_reason}. "
            "Проверьте /diagnostics и выполните /resume после устранения причины."
        )
    elif state == "completed" and stats.telegram_cards == 0:
        reasons = (stats.rejection_reasons + stats.error_reasons).most_common(3)
        reason_text = ", ".join(f"{name}={count}" for name, count in reasons)
        notification = (
            f"Цикл завершён: найдено {stats.found_results}, "
            f"новых {stats.new_vacancies}, карточек: 0."
            + (f" Причины: {reason_text}." if reason_text else "")
        )
    else:
        notification = ""

    run_id = database.save_search_run(
        started_at=started_at,
        finished_at=now(),
        state=state,
        query_count=stats.query_count,
        found_results=stats.found_results,
        new_vacancies=stats.new_vacancies,
        duplicates=stats.duplicates,
        rejected_by_filter=stats.rejected_by_filter,
        telegram_cards=stats.telegram_cards,
        error_count=stats.error_count,
        rejection_reasons=dict(stats.rejection_reasons),
        error_reasons=dict(stats.error_reasons),
        last_safe_error=stats.last_safe_error,
        circuit_reason=circuit_reason,
        telegram_user_id=target_user_id,
    )
    if failure is not None:
        # The original exception may embed a URL with a session token.  Keep
        # its type/identifier only; the safe error was already recorded.
        raise RuntimeError(
            safe_exception_message(failure, operation="search_cycle")
        ) from None
    if notification:
        try:
            await telegram.notify(notification, telegram_user_id=target_user_id)
        except TelegramAPIError:
            database.record_search_run_error(run_id, "telegram_error")
    result = database.latest_search_run(telegram_user_id=target_user_id)
    if result is None:
        raise RuntimeError("search run was not saved")
    logger.info(
        "search_cycle_finished state=%s cards=%s errors=%s",
        result.state,
        result.telegram_cards,
        result.error_count,
    )
    return result


async def apply_session_state(
    context: UserRuntimeContext,
    state: LoginState,
    telegram: TelegramService,
) -> None:
    """Apply a session check result to the per-user runtime gate.

    Technical failures never clear an existing auth pause and never claim
    that the HH session expired.  They only block work until a positive
    check restores AUTHORIZED.
    """
    context.auth_state = state.value
    if state is LoginState.AUTHORIZED:
        context.auth_paused = False
        context.auth_reason = ""
        return

    if state in {LoginState.UNKNOWN, LoginState.CHECK_FAILED}:
        # Preserve an existing auth pause; do not invent an expiry reason.
        if context.auth_paused:
            context.auth_reason = "session_check_unconfirmed"
        return

    context.auth_paused = True
    context.auth_reason = state.value
    context.next_run_at = None
    if state is LoginState.NOT_AUTHORIZED:
        message = "HH.kz authorization is required. Sign in and use /resume."
    else:
        message = (
            "HH.kz session is no longer available. Sign in and use /resume."
        )
    try:
        await telegram.notify(message, telegram_user_id=context.telegram_user_id)
    except Exception as exc:
        logger.warning(
            "session_notification_failed user=%s error=%s",
            context.telegram_user_id,
            type(exc).__name__,
        )


async def session_watchdog(
    context: UserRuntimeContext,
    hh_client: HHClient,
    telegram: TelegramService,
) -> None:
    """Recheck the HH session periodically without stopping Telegram.

    All exceptions are contained here: an unhandled error would propagate
    through ``asyncio.gather`` and tear down polling and the browser.
    """
    interval_seconds = max(1, context.user_settings.check_interval_minutes) * 60
    while True:
        try:
            state = await hh_client.check_session()
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            logger.warning(
                "session_watchdog_error user=%s error=%s",
                context.telegram_user_id,
                type(exc).__name__,
            )
            state = LoginState.CHECK_FAILED
        await apply_session_state(context, state, telegram)
        await asyncio.sleep(interval_seconds)


async def agent_loop(
    context: UserRuntimeContext,
    hh_client: HHClient,
    telegram: TelegramService,
) -> None:
    target_user_id = context.telegram_user_id
    # Stage 4\6: the polling interval is a per-user setting.
    settings = context.user_settings
    while True:
        # Phase 5.6: an unconfirmed HH session blocks the cycle.  The
        # circuit-breaker pause and the auth pause are independent.
        if not context.paused and runtime_allows_hh_work(context):
            run = await run_search_cycle(
                context, hh_client, telegram,
            )
            context.next_run_at = (
                None
                if context.paused
                else datetime.fromisoformat(run.finished_at)
                + timedelta(minutes=settings.check_interval_minutes)
            )
        else:
            context.next_run_at = None
        try:
            await asyncio.wait_for(
                context.wake_event.wait(), settings.check_interval_minutes * 60
            )
        except TimeoutError:
            pass
        finally:
            context.wake_event.clear()
            context.next_run_at = None


def _hh_account_profile_dir(
    settings: Settings,
    hh_account: HHAccount,
) -> Path:
    """Return the persistent browser profile directory for an HHAccount.

    Phase 5.3: the path stored in the database always wins, so an already
    initialised account keeps exactly the same browser profile between
    restarts.  Only an empty value produces a new, stable path.  The
    generated directory name is derived exclusively from the integer
    HHAccount id and is therefore safe (no user-supplied text, no path
    traversal) and unique per account.
    """
    stored = hh_account.browser_profile_dir.strip()
    if stored:
        return Path(stored)

    account_id = int(hh_account.id)
    if account_id <= 0:
        raise RuntimeError(
            "Cannot build a browser profile directory for HH account of "
            f"Telegram user {hh_account.telegram_user_id}: invalid account id"
        )

    return Path(settings.browser_profile_dir) / f"hh-account-{account_id}"


async def run(settings: Settings, telegram_user_id: int | None = None) -> None:
    database = Database(settings.database_path)
    database.init()
    backend = None
    telegram: TelegramService | None = None
    try:
        if telegram_user_id is None:
            # Stage 4\3: polling-only mode. No user-specific runtime
            # components are created; the bot answers commands but no
            # agent loop is started.  Phase 5.3: no HHAccount, browser
            # profile or browser backend is created in this mode.
            approval_service = ApprovalService(
                settings.user_defaults, database, _NullSender()
            )
            telegram = TelegramService(
                settings,
                database,
                approval_service,
                contexts={},
            )
            if hasattr(telegram, "check_updates"):
                asyncio.create_task(telegram.check_updates(notify=True))
            await telegram.start_polling()
            return

        # Phase 5.7: protect the browser profile root and every existing
        # account profile before any account profile is selected or launched.
        # Nothing is moved, renamed or deleted here.
        # Each component is validated immediately before it is created; a
        # junction in the profile root cannot redirect directory creation.
        profile_root = ensure_validated_directory(
            settings.browser_profile_dir, kind="browser profile root"
        )
        protect_directory(profile_root, recursive=True)

        # Phase 5.3: the HHAccount must exist before the browser starts,
        # because it owns the persistent browser profile directory.
        # ``create_user`` is INSERT OR IGNORE and is required by the
        # hh_accounts.telegram_user_id foreign key.
        database.create_user(telegram_user_id=telegram_user_id)
        hh_account = database.get_or_create_hh_account(telegram_user_id)

        # Phase 5.4: verify that the account id and the authenticated
        # Telegram user id identify the SAME database row BEFORE any
        # browser profile is read or any browser backend is created.
        hh_account = verify_hh_account_ownership(
            database,
            telegram_user_id,
            hh_account,
        )

        if not hh_account.browser_profile_dir.strip():
            generated_profile_dir = _hh_account_profile_dir(
                settings,
                hh_account,
            )
            # Persist BEFORE launching the browser.  Never run a browser
            # with a path that was not stored, otherwise the authorisation
            # state could silently be lost on the next start.
            if not database.update_hh_account(
                telegram_user_id,
                browser_profile_dir=str(generated_profile_dir),
            ):
                raise RuntimeError(
                    "Failed to save the browser profile directory for "
                    f"HH account {hh_account.id} "
                    f"(Telegram user {telegram_user_id}). "
                    "Browser was not started."
                )

            # Reload and re-verify the persisted account so the browser
            # can only use a profile that belongs to this exact row.
            stored_account = database.get_hh_account_by_id(
                hh_account.id,
                telegram_user_id,
            )
            if stored_account is None:
                raise HHAccountOwnershipError(
                    "Saved HH account could not be reloaded for Telegram "
                    f"user {telegram_user_id}. Browser was not started."
                )
            hh_account = verify_hh_account_ownership(
                database,
                telegram_user_id,
                stored_account,
            )
            if Path(hh_account.browser_profile_dir) != generated_profile_dir:
                raise HHAccountOwnershipError(
                    "Saved browser profile does not belong to the verified "
                    "HH account. Browser was not started."
                )

        if not hh_account.browser_profile_dir.strip():
            raise HHAccountOwnershipError(
                "Verified HH account has no browser profile directory. "
                "Browser was not started."
            )

        # Stage 4\6: materialise the ONE per-user configuration instance.
        # Every user-scoped component below shares this exact object.
        user_settings = load_user_settings(settings)

        # Stage 4\4: legacy single-user agent loop with explicit
        # telegram_user_id. Runtime control state lives inside the
        # per-user UserRuntimeContext — no shared AgentControl.
        # The context stores the very same UserSettings instance.
        # Phase 5.4: the verified HHAccount is passed explicitly and the
        # context re-validates it against the database.  Context
        # construction has no browser dependency, so it happens BEFORE
        # the backend is created/started: an ownership failure here can
        # never reach the browser.
        context = create_runtime_context(
            telegram_user_id=telegram_user_id,
            settings=settings,
            database=database,
            user_settings=user_settings,
            hh_account=hh_account,
        )

        # Phase 5.3: each HHAccount gets its own persistent profile, so
        # the existing Playwright/CloakBrowser persistent context keeps
        # the HH.kz authorisation state on disk for this account only.
        # Phase 5.4: only the verified account record reaches this point.
        profile_dir = Path(hh_account.browser_profile_dir)
        backend = create_browser_backend(settings, profile_dir=profile_dir)
        browser_context = await backend.start()

        # Stage 4\6: approval components share the user's single settings.
        # HHClient requires this guard at construction time, so it must be
        # created before the client (and before ensure_login()).
        guard = ApprovalGuard(context.user_settings, database)

        # Stage 4\5: HHClient получает явный telegram_user_id через конструктор.
        # Инвариант: hh_client.telegram_user_id == telegram_user_id
        hh_client = HHClient(
            browser_context,
            settings,
            database,
            guard,
            telegram_user_id=telegram_user_id,
            user_settings=context.user_settings,
            hh_account=context.hh_account,
            session_lock=context.session_lock,
        )
        # Phase 5.5: the persistent profile is reused as-is.  ensure_login()
        # confirms a positive HH.kz authorisation (or performs a manual login
        # and re-checks it) before any agent work is allowed to start.
        if not await hh_client.ensure_login():
            if settings.browser_headless:
                raise RuntimeError(
                    "HH.kz authorization is not confirmed in headless mode. "
                    "Use the existing authorized browser profile or run once "
                    "with BROWSER_HEADLESS=false and sign in manually."
                )
            raise RuntimeError(
                "HH.kz authorization was not confirmed. "
                "Run with BROWSER_HEADLESS=false and sign in manually."
            )

        # Phase 5.6: the startup check is the first positive confirmation.
        context.auth_state = HHAccountStatus.AUTHORIZED.value
        context.auth_paused = False
        context.auth_reason = ""

        approval_service = ApprovalService(context.user_settings, database, hh_client)

        telegram = TelegramService(
            settings,
            database,
            approval_service,
            contexts={telegram_user_id: context},
            hh_client=hh_client,
        )

        if hasattr(telegram, "check_updates"):
            asyncio.create_task(telegram.check_updates(notify=True))
        await asyncio.gather(
            telegram.start_polling(),
            agent_loop(context, hh_client, telegram),
            # The watchdog catches its own errors; polling and agent work
            # stay alive even when HH.kz cannot be checked temporarily.
            session_watchdog(context, hh_client, telegram),
        )
    finally:
        try:
            if telegram is not None:
                await telegram.stop()
        finally:
            if backend is not None:
                await backend.close()


class _NullSender:
    """Polling-only mode never submits applications.

    Stage 4\3: when no telegram_user_id is given there is no agent
    runtime, so the approval service is wired to a sender that always
    refuses.  This keeps TelegramService constructible without creating
    any user-specific runtime components.
    """

    async def submit_application(self, permission) -> bool:
        return False


def cli(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="HH.kz Agent")
    parser.add_argument(
        "--version",
        action="version",
        version=f"HH Agent v{__version__}",
    )
    parser.add_argument("--env-file", type=Path, default=Path(".env"))
    parser.add_argument("--profile", type=Path)
    parser.add_argument("--check-config", action="store_true")
    parser.add_argument(
        "--telegram-user-id",
        type=int,
        default=None,
        help="Run legacy single-user agent loop for the given Telegram user ID",
    )
    args = parser.parse_args(argv)
    try:
        settings = load_settings(args.env_file, args.profile)
    except ConfigError as exc:
        # ConfigError text is built from field names, but pass it through the
        # same redactor so an unexpected value can never reach the terminal.
        print(redact_sensitive_text(exc), file=sys.stderr)
        return 2
    if args.check_config:
        print(
            f"Configuration valid: mode={settings.app_mode}, "
            f"browser={settings.browser_backend}"
        )
        return 0
    configure_logging(settings.log_path)
    try:
        asyncio.run(run(settings, telegram_user_id=args.telegram_user_id))
    except (BrowserLaunchError, RuntimeError) as exc:
        # Browser exceptions can contain full URLs, cookies and tokens.  Only
        # the type and a controlled identifier are safe to log or display.
        detail = safe_exception_message(exc, operation="startup")
        logger.error("startup_failed %s", detail)
        print(f"Startup failed: {detail}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        logger.info("agent_stopped")
    return 0


if __name__ == "__main__":
    raise SystemExit(cli())
"""Security-conscious logging for the HH agent.

A single redacting filter is attached to every handler installed by
:func:`configure_logging`.  It removes credentials, tokens, cookies,
Authorization headers and secret-bearing URL parameters from log records,
and replaces raw tracebacks with controlled exception identifiers.
"""

from __future__ import annotations

import copy
import logging
import re
import sys
from logging.handlers import RotatingFileHandler as _RotatingFileHandler
from pathlib import Path
from typing import Mapping

from security_utils import (
    ensure_validated_directory,
    open_validated_file,
    protect_log_file,
    validate_path_before_io,
)

REDACTED = "[REDACTED]"

_SECRET_KEYS = (
    "password",
    "passwd",
    "pwd",
    "proxy[_-]?authorization",
    "authorization",
    "access[_-]?token",
    "refresh[_-]?token",
    "id[_-]?token",
    "client[_-]?secret",
    # client_id must always be redacted: a fixed "authorization context" window
    # leaked long JSON records, multiline messages and reordered fields.
    "client[_-]?id",
    "tg[_-]?bot[_-]?token",
    "bot[_-]?token",
    "api[_-]?(?:key|secret|token)",
    "apikey",
    "private[_-]?key",
    "secret[_-]?key",
    "signing[_-]?(?:key|secret)",
    "webhook[_-]?(?:secret|token)",
    "auth[_-]?(?:code|token)",
    "oauth[_-]?token",
    "session[_-]?(?:id|identifier|token|key)",
    "sessionid",
    "credential(?:s)?",
    "secret",
    "token",
    "cookie",
    "sid",
)

_SECRET_ASSIGNMENT = re.compile(
    r'(?P<key>"?\b(?:' + "|".join(_SECRET_KEYS) + r')\b"?)'
    r"\s*(?P<separator>[:=])\s*"
    # ``]`` is allowed in a bare value so ``token=[REDACTED]leak`` is captured
    # as a whole instead of stopping at the placeholder's closing bracket.
    r"(?P<value>\"[^\"]*\"|'[^']*'|[^\s,;}&)]+)",
    re.IGNORECASE,
)
# A sensitive header owns the whole remainder of its line.  Matching only the
# first token would leave additional Basic credentials or cookie pairs intact.
# The alternation is ordered longest-first so Proxy-Authorization and
# Set-Cookie are not partially matched by their shorter suffixes.
_SECRET_HEADER = re.compile(
    r"(?<![\w-])(?P<header>proxy-authorization|authorization|x-api-key|"
    r"x-auth-token|set-cookie|cookie)[ \t]*:[ \t]*(?P<value>[^\r\n]*)",
    re.IGNORECASE,
)
# A bearer value owns the rest of its line.  Otherwise a placeholder followed
# by a real credential would leave the credential visible.
_BEARER_TOKEN = re.compile(
    r"\bBearer[ \t]+(?P<value>[^\r\n]+)", re.IGNORECASE
)
_SECRET_URL_PARAMETER = re.compile(
    r"(?P<prefix>[?&](?:proxy_authorization|authorization|access_token|"
    r"refresh_token|id_token|client_secret|client_id|clientid|bot_token|tg_bot_token|api_key|"
    r"api_secret|api_token|apikey|password|passwd|secret|token|session_id|"
    r"sessionid|sid|auth|code|key|sig|"
    r"signature|ticket|state|credential|private_key)=)"
    r"(?P<value>[^&#\s]+)",
    re.IGNORECASE,
)

_SAFE_ERROR_IDS: Mapping[str, str] = {
    "BrowserLaunchError": "browser_launch_failed",
    "TimeoutError": "operation_timeout",
    "asyncio.TimeoutError": "operation_timeout",
    "ConnectionError": "connection_failed",
    "OSError": "filesystem_error",
    "FilesystemProtectionError": "filesystem_protection_failed",
    "ConfigError": "configuration_error",
    "HHAccountOwnershipError": "ownership_rejected",
    "TelegramAPIError": "telegram_api_error",
    "ValueError": "invalid_value",
}


def safe_exception_name(exc: BaseException | None) -> str:
    """Return only an exception type name, never its raw message."""
    return type(exc).__name__ if exc is not None else "None"


def safe_error_id(exc: BaseException | None) -> str:
    """Return a stable, secret-free identifier for an exception."""
    name = safe_exception_name(exc)
    return _SAFE_ERROR_IDS.get(name, "operation_failed")


def safe_exception_message(
    exc: BaseException | None,
    *,
    operation: str = "operation",
) -> str:
    """Build a diagnostic string that cannot carry exception payloads."""
    return (
        f"{operation}_failed "
        f"error_id={safe_error_id(exc)} "
        f"error_type={safe_exception_name(exc)}"
    )


def _already_redacted(value: str) -> bool:
    """Return True only when the whole value is the expected placeholder.

    A substring check would let an attacker keep a credential by prefixing it
    with ``[REDACTED]``.  Surrounding whitespace and a matching pair of quotes
    are accepted because those are part of the surrounding log format, not of
    the value itself.
    """
    candidate = value.strip()
    if len(candidate) >= 2 and candidate[0] == candidate[-1] and candidate[0] in "\"'":
        candidate = candidate[1:-1].strip()
    return candidate == REDACTED


def _placeholder_tampered(value: str) -> bool:
    """A placeholder plus extra data is always treated as a real secret."""
    return REDACTED in value and not _already_redacted(value)


def _redacted_value(value: str) -> str:
    """Keep the original quoting style when replacing a quoted secret."""
    if len(value) >= 2 and value[0] in "\"'" and value[-1] == value[0]:
        return f"{value[0]}{REDACTED}{value[0]}"
    return REDACTED


def redact_sensitive_text(value: object) -> str:
    """Redact known secret-bearing patterns in arbitrary log values."""
    text = str(value)

    def replace_header(match: re.Match[str]) -> str:
        if _already_redacted(match.group("value")):
            return match.group(0)
        return f"{match.group('header')}: {REDACTED}"

    def replace_assignment(match: re.Match[str]) -> str:
        if _already_redacted(match.group("value")):
            return match.group(0)
        # The whole value is consumed, so ``[REDACTED]tail`` cannot survive.
        return (
            f"{match.group('key')}{match.group('separator')}"
            f"{_redacted_value(match.group('value'))}"
        )

    def replace_bearer(match: re.Match[str]) -> str:
        if _already_redacted(match.group("value")):
            return match.group(0)
        return f"Bearer {REDACTED}"

    def replace_url_parameter(match: re.Match[str]) -> str:
        if _already_redacted(match.group("value")):
            return match.group(0)
        return f"{match.group('prefix')}{REDACTED}"

    text = _SECRET_HEADER.sub(replace_header, text)
    text = _SECRET_ASSIGNMENT.sub(replace_assignment, text)
    text = _BEARER_TOKEN.sub(replace_bearer, text)
    text = _SECRET_URL_PARAMETER.sub(replace_url_parameter, text)
    return text


def _logger_handle_with_record_replacement(
    logger: logging.Logger, record: logging.LogRecord
) -> None:
    """Python 3.11 backport of the 3.12 ``Logger.handle`` contract."""
    if logger.disabled:
        return
    maybe_record = logger.filter(record)
    if not maybe_record:
        return
    if isinstance(maybe_record, logging.LogRecord):
        record = maybe_record
    logger.callHandlers(record)


def _handler_handle_with_record_replacement(
    handler: logging.Handler, record: logging.LogRecord
) -> bool | logging.LogRecord:
    """Python 3.11 backport of the 3.12 ``Handler.handle`` contract."""
    result = handler.filter(record)
    if isinstance(result, logging.LogRecord):
        record = result
    if result:
        with handler.lock:
            handler.emit(record)
    return result


def _install_log_record_replacement_compat() -> None:
    """Make filter-returned records work on the project minimum Python 3.11.

    Python 3.12 added replacement of a ``LogRecord`` returned by a filter in
    both ``Logger.handle`` and ``Handler.handle``.  The project still supports
    3.11, so install a narrow compatibility shim there.  This preserves the
    no-mutation design instead of falling back to editing shared records.
    """
    if sys.version_info >= (3, 12):
        return
    if getattr(logging.Logger.handle, "_phase57_record_replacement", False):
        return
    logging.Logger.handle = _logger_handle_with_record_replacement  # type: ignore[method-assign]
    logging.Handler.handle = _handler_handle_with_record_replacement  # type: ignore[method-assign]
    logging.Logger.handle._phase57_record_replacement = True  # type: ignore[attr-defined]
    logging.Handler.handle._phase57_record_replacement = True  # type: ignore[attr-defined]


_install_log_record_replacement_compat()


class RedactingFilter(logging.Filter):
    """Return a redacted copy instead of mutating the shared LogRecord.

    Python 3.12 natively replaces a record returned by a filter in both
    ``Logger.handle`` and ``Handler.handle``.  On Python 3.11 the module
    installs a compatibility shim with the same semantics.  Each handler
    therefore receives its own redacted copy, while other handlers and filters
    still see the original ``msg``, ``args``, ``exc_info`` and ``stack_info``.
    """

    def filter(self, record: logging.LogRecord) -> logging.LogRecord | bool:
        if getattr(record, "_phase57_redacted", False):
            return True

        safe = copy.copy(record)
        message = redact_sensitive_text(safe.getMessage())
        if safe.exc_info:
            message = (
                f"{message} exception={safe_exception_name(safe.exc_info[1])}"
            )
        safe.msg = message
        safe.args = ()
        safe.message = message
        safe.exc_info = None
        safe.exc_text = None
        safe.stack_info = None
        safe._phase57_redacted = True
        return safe


class _ValidatedRotatingFileHandler(_RotatingFileHandler):
    """Rotating file handler whose initial open is handle-validated."""

    def _open(self):  # type: ignore[override]
        return open_validated_file(
            self.baseFilename,
            self.mode,
            kind="log file",
            encoding=self.encoding,
            errors=self.errors,
        )


# Keep the public module name used by configure_logging() and by the
# preflight-order regression test.
RotatingFileHandler = _ValidatedRotatingFileHandler


def configure_logging(log_path: Path) -> None:
    """Configure console + rotating file logging with one redacting filter."""
    log_path = Path(log_path)
    # Reject symlinks/junctions in every existing component before mkdir() or
    # the RotatingFileHandler can create a file outside the intended tree.
    validate_path_before_io(log_path, kind="log file")
    ensure_validated_directory(log_path.parent, kind="log directory")
    protect_log_file(log_path)

    formatter = logging.Formatter(
        "%(asctime)s %(levelname)s %(name)s %(message)s"
    )
    redactor = RedactingFilter()

    console = logging.StreamHandler()
    console.setFormatter(formatter)
    console.addFilter(redactor)

    rotating_file = RotatingFileHandler(
        log_path, maxBytes=2 * 1024 * 1024, backupCount=3, encoding="utf-8"
    )
    # The handler creates the file after the directory was protected.  Apply
    # protection again so the file itself has a protected DACL / 0600 mode.
    protect_log_file(log_path)
    rotating_file.setFormatter(formatter)
    rotating_file.addFilter(redactor)

    root = logging.getLogger()
    root.addFilter(redactor)
    logging.basicConfig(level=logging.INFO, handlers=[console, rotating_file], force=True)

