    def mark_submit_attempt(
        self,
        job_id: str,
        permit: str,
        *,
        telegram_user_id: int | None = None,
        now: datetime,
        daily_limit: int,
    ) -> bool:
        supplied_hash = hashlib.sha256(permit.encode()).hexdigest()
        with self._connect() as connection:
            connection.execute("BEGIN IMMEDIATE")
            row = connection.execute(
                "SELECT * FROM vacancies WHERE id = ?", (job_id,)
            ).fetchone()
            if (
                row is None
                or row["status"] != VacancyStatus.APPLYING.value
                or not secrets.compare_digest(row["permit_hash"] or "", supplied_hash)
            ):
                return False
            if not row["approval_expires_at"] or row["approval_expires_at"] <= _iso(now):
                connection.execute(
                    "UPDATE vacancies SET status = ?, permit_hash = NULL WHERE id = ? AND status = ? AND permit_hash = ?",
                    (
                        VacancyStatus.EXPIRED.value,
                        job_id,
                        VacancyStatus.APPLYING.value,
                        row["permit_hash"],
                    ),
                )
                return False
            start, end = self._day_bounds(now)
            this_row_reserved = any(
                timestamp is not None and start <= timestamp < end
                for timestamp in (row["applying_at"], row["submit_attempted_at"])
            )
            reserved = self._reserved_today(connection, now, telegram_user_id) if telegram_user_id is not None else self._reserved_today(connection, now)
            if reserved - int(this_row_reserved) >= daily_limit:
                return False
            cursor = connection.execute(
                """
                UPDATE vacancies SET submit_attempted_at = ?
                WHERE id = ? AND status = ? AND permit_hash = ?
                    AND submit_attempted_at IS NULL
                """,
                (
                    _iso(now),
                    job_id,
                    VacancyStatus.APPLYING.value,
                    row["permit_hash"],
                ),
            )
            return cursor.rowcount == 1

    @staticmethod
    def _day_bounds(now: datetime) -> tuple[str, str]:
        aware = now.replace(tzinfo=UTC) if now.tzinfo is None else now
        start = datetime.combine(aware.date(), time.min, tzinfo=aware.tzinfo)
        return _iso(start), _iso(start + timedelta(days=1))

    def _applied_today(self, connection: sqlite3.Connection, now: datetime, telegram_user_id: int | None = None) -> int:
        start, end = self._day_bounds(now)
        if telegram_user_id is not None:
            return int(
                connection.execute(
                    """
                    SELECT COUNT(*) FROM vacancies
                    WHERE (
                        telegram_user_id = ?
                        OR (telegram_user_id IS NULL AND approver_id = ?)
                    )
                    AND status = ? AND applied_at >= ? AND applied_at < ?
                    """,
                    (telegram_user_id, telegram_user_id, VacancyStatus.APPLIED.value, start, end),
                ).fetchone()[0]
            )
        return int(
            connection.execute(
                "SELECT COUNT(*) FROM vacancies WHERE status = ? AND applied_at >= ? AND applied_at < ?",
                (VacancyStatus.APPLIED.value, start, end),
            ).fetchone()[0]
        )

    def _reserved_today(self, connection: sqlite3.Connection, now: datetime, telegram_user_id: int | None = None) -> int:
        start, end = self._day_bounds(now)
        if telegram_user_id is not None:
            return int(
                connection.execute(
                    """
                    SELECT COUNT(*) FROM vacancies
                    WHERE (
                        telegram_user_id = ?
                        OR (telegram_user_id IS NULL AND approver_id = ?)
                    )
                    AND (
                        (status = ? AND applied_at >= ? AND applied_at < ?)
                        OR (status = ? AND applying_at >= ? AND applying_at < ?)
                        OR (status IN (?, ?) AND submit_attempted_at >= ? AND submit_attempted_at < ?)
                    )
                    """,
                    (
                        telegram_user_id,
                        telegram_user_id,
                        VacancyStatus.APPLIED.value,
                        start,
                        end,
                        VacancyStatus.APPLYING.value,
                        start,
                        end,
                        VacancyStatus.APPLYING.value,
                        VacancyStatus.APPLY_FAILED.value,
                        start,
                        end,
                    ),
                ).fetchone()[0]
            )
        return int(
            connection.execute(
                """
                SELECT COUNT(*) FROM vacancies
                WHERE (status = ? AND applied_at >= ? AND applied_at < ?)
                   OR (status = ? AND applying_at >= ? AND applying_at < ?)
                   OR (status IN (?, ?) AND submit_attempted_at >= ? AND submit_attempted_at < ?)
                """,
                (
                    VacancyStatus.APPLIED.value,
                    start,
                    end,
                    VacancyStatus.APPLYING.value,
                    start,
                    end,
                    VacancyStatus.APPLYING.value,
                    VacancyStatus.APPLY_FAILED.value,
                    start,
                    end,
                ),
            ).fetchone()[0]
        )

    def applied_today(self, now: datetime, telegram_user_id: int | None = None) -> int:
        with self._connect() as connection:
            return self._applied_today(connection, now, telegram_user_id)

    def expire_approved(self, now: datetime, telegram_user_id: int | None = None) -> int:
        with self._connect() as connection:
            connection.execute("BEGIN IMMEDIATE")
            if telegram_user_id is not None:
                cursor = connection.execute(
                    """
                    UPDATE vacancies SET status = ?, permit_hash = NULL
                    WHERE status = ?
                        AND approval_expires_at IS NOT NULL
                        AND approval_expires_at <= ?
                        AND (telegram_user_id = ? OR telegram_user_id IS NULL)
                    """,
                    (
                        VacancyStatus.EXPIRED.value,
                        VacancyStatus.APPROVED.value,
                        _iso(now),
                        telegram_user_id,
                    ),
                )
            else:
                cursor = connection.execute(
                    """
                    UPDATE vacancies SET status = ?, permit_hash = NULL
                    WHERE status = ?
                        AND approval_expires_at IS NOT NULL
                        AND approval_expires_at <= ?
                    """,
                    (
                        VacancyStatus.EXPIRED.value,
                        VacancyStatus.APPROVED.value,
                        _iso(now),
                    ),
                )
            return cursor.rowcount

    def pending(self, telegram_user_id: int | None = None) -> list[Vacancy]:
        with self._connect() as connection:
            if telegram_user_id is not None:
                rows = connection.execute(
                    "SELECT * FROM vacancies WHERE status = ? AND (telegram_user_id = ? OR telegram_user_id IS NULL) ORDER BY discovered_at",
                    (VacancyStatus.PENDING_APPROVAL.value, telegram_user_id),
                ).fetchall()
            else:
                rows = connection.execute(
                    "SELECT * FROM vacancies WHERE status = ? ORDER BY discovered_at",
                    (VacancyStatus.PENDING_APPROVAL.value,),
                ).fetchall()
            return [self._vacancy(row) for row in rows]

    def stats(self, telegram_user_id: int | None = None) -> dict[str, int]:
        counts = {status.value: 0 for status in VacancyStatus}
        with self._connect() as connection:
            if telegram_user_id is not None:
                for row in connection.execute(
                    "SELECT status, COUNT(*) AS count FROM vacancies WHERE telegram_user_id = ? GROUP BY status",
                    (telegram_user_id,),
                ):
                    counts[row["status"]] = row["count"]
            else:
                for row in connection.execute(
                    "SELECT status, COUNT(*) AS count FROM vacancies GROUP BY status"
                ):
                    counts[row["status"]] = row["count"]
        return counts

    def save_search_run(
        self,
        *,
        started_at: datetime,
        finished_at: datetime,
        state: str,
        query_count: int,
        found_results: int,
        new_vacancies: int,
        duplicates: int,
        rejected_by_filter: int,
        telegram_cards: int,
        error_count: int,
        rejection_reasons: dict[str, int],
        error_reasons: dict[str, int],
        last_safe_error: str = "",
        circuit_reason: str = "",
        telegram_user_id: int | None = None,
    ) -> int:
        with self._connect() as connection:
            cursor = connection.execute(
                """
                INSERT INTO search_runs (
                    telegram_user_id, started_at, finished_at, state, query_count, found_results,
                    new_vacancies, duplicates, rejected_by_filter,
                    telegram_cards, error_count, rejection_reasons_json,
                    error_reasons_json, last_safe_error, circuit_reason
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    telegram_user_id,
                    _iso(started_at),
                    _iso(finished_at),
                    state,
                    query_count,
                    found_results,
                    new_vacancies,
                    duplicates,
                    rejected_by_filter,
                    telegram_cards,
                    error_count,
                    json.dumps(rejection_reasons, ensure_ascii=False, sort_keys=True),
                    json.dumps(error_reasons, ensure_ascii=False, sort_keys=True),
                    last_safe_error,
                    circuit_reason,
                ),
            )
            return int(cursor.lastrowid)

    def latest_search_run(self, telegram_user_id: int | None = None) -> SearchRun | None:
        with self._connect() as connection:
            if telegram_user_id is not None:
                row = connection.execute(
                    """
                    SELECT * FROM search_runs
                    WHERE telegram_user_id = ?
                    ORDER BY id DESC LIMIT 1
                    """,
                    (telegram_user_id,),
                ).fetchone()
            else:
                row = connection.execute(
                    "SELECT * FROM search_runs ORDER BY id DESC LIMIT 1"
                ).fetchone()
        if row is None:
            return None
        return SearchRun(
            id=row["id"],
            started_at=row["started_at"],
            finished_at=row["finished_at"],
            state=row["state"],
            query_count=row["query_count"],
            found_results=row["found_results"],
            new_vacancies=row["new_vacancies"],
            duplicates=row["duplicates"],
            rejected_by_filter=row["rejected_by_filter"],
            telegram_cards=row["telegram_cards"],
            error_count=row["error_count"],
            rejection_reasons=json.loads(row["rejection_reasons_json"]),
            error_reasons=json.loads(row["error_reasons_json"]),
            last_safe_error=row["last_safe_error"],
            circuit_reason=row["circuit_reason"],
            telegram_user_id=row["telegram_user_id"],
        )

    def record_search_run_error(
        self, run_id: int, reason: str, telegram_user_id: int | None = None
    ) -> bool:
        with self._connect() as connection:
            if telegram_user_id is not None:
                row = connection.execute(
                    """
                    SELECT error_reasons_json FROM search_runs
                    WHERE id = ? AND telegram_user_id = ?
                    """,
                    (run_id, telegram_user_id),
                ).fetchone()
            else:
                row = connection.execute(
                    "SELECT error_reasons_json FROM search_runs WHERE id = ?",
                    (run_id,),
                ).fetchone()
            if row is None:
                return False
            reasons = json.loads(row["error_reasons_json"])
            reasons[reason] = reasons.get(reason, 0) + 1
            if telegram_user_id is not None:
                cursor = connection.execute(
                    """
                    UPDATE search_runs
                    SET error_count = error_count + 1,
                        error_reasons_json = ?, last_safe_error = ?
                    WHERE id = ? AND telegram_user_id = ?
                    """,
                    (json.dumps(reasons, ensure_ascii=False, sort_keys=True), reason, run_id, telegram_user_id),
                )
            else:
                cursor = connection.execute(
                    """
                    UPDATE search_runs
                    SET error_count = error_count + 1,
                        error_reasons_json = ?, last_safe_error = ?
                    WHERE id = ?
                    """,
                    (json.dumps(reasons, ensure_ascii=False, sort_keys=True), reason, run_id),
                )
            return cursor.rowcount == 1

    def is_message_processed(self, message_id: str) -> bool:
        with self._connect() as connection:
            return (
                connection.execute(
                    "SELECT 1 FROM chat_messages WHERE msg_id = ?", (message_id,)
                ).fetchone()
                is not None
            )

    def add_processed_message(self, message_id: str, chat_id: str, text_value: str) -> bool:
        with self._connect() as connection:
            cursor = connection.execute(
                "INSERT OR IGNORE INTO chat_messages (msg_id, chat_id, text) VALUES (?, ?, ?)",
                (message_id, chat_id, text_value),
            )
            return cursor.rowcount == 1
from __future__ import annotations

import os
from dataclasses import dataclass
from io import StringIO
from pathlib import Path
from typing import Mapping

import yaml
from dotenv import dotenv_values

from security_utils import (
    FilesystemProtectionError,
    protect_config_file,
    read_validated_text,
    validate_path_before_io,
)


BASE_DIR = Path(__file__).resolve().parent


class ConfigError(ValueError):
    pass


@dataclass(frozen=True)
class CandidateProfile:
    name: str
    location: str
    desired_positions: tuple[str, ...]
    experience_summary: str
    education: str
    technologies: tuple[str, ...]
    projects: tuple[str, ...]
    github_url: str
    salary_expectation: str
    work_format: tuple[str, ...]
    excluded_positions: tuple[str, ...]
    additional_information: str


@dataclass(frozen=True)
class HHProfile:
    resume_name: str
    search_queries: tuple[str, ...]
    areas: tuple[str, ...]
    experience_filters: tuple[str, ...]


@dataclass(frozen=True)
class Profile:
    candidate: CandidateProfile
    hh: HHProfile


@dataclass(frozen=True)
class UserSettings:
    """Per-user configuration snapshot owned by a single Telegram user.

    Stage 4\6: every field here is meaningful only in the context of one
    concrete user.  Each call to :func:`load_user_settings` returns a fresh
    immutable instance, so two users never share a mutable configuration
    object.  ``profile`` is stored as an immutable frozen dataclass — the
    nested tuples make it safe to share by reference between snapshots.
    """

    app_mode: str
    enable_real_apply: bool
    check_interval_minutes: int
    max_applications_per_day: int
    approval_ttl_minutes: int
    profile: Profile

    @classmethod
    def from_defaults(
        cls,
        *,
        app_mode: str = "dry_run",
        enable_real_apply: bool = False,
        check_interval_minutes: int = 30,
        max_applications_per_day: int = 5,
        approval_ttl_minutes: int = 30,
        profile: Profile | None = None,
    ) -> "UserSettings":
        """Create an isolated per-user settings instance.

        Each call returns a fresh immutable object; two users therefore
        never share user-specific configuration.
        """
        return cls(
            app_mode=app_mode,
            enable_real_apply=enable_real_apply,
            check_interval_minutes=check_interval_minutes,
            max_applications_per_day=max_applications_per_day,
            approval_ttl_minutes=approval_ttl_minutes,
            profile=profile
            if profile is not None
            else Profile(
                candidate=CandidateProfile("", "", (), "", "", (), (), "", "", (), (), ""),
                hh=HHProfile("", (), (), ()),
            ),
        )


@dataclass(frozen=True)
class Settings:
    """Global process-level configuration.

    Stage 4\6: this class keeps the *existing* global configuration
    contract intact (``app_mode``, ``profile``, ``tg_bot_token``,
    ``database_path`` and all previously existing fields) so that legacy
    callers, ``setup_wizard.py`` and existing tests keep working.

    In addition it carries ``user_defaults`` — an immutable snapshot used
    ONLY to bootstrap a user's own :class:`UserSettings` instance.  It is
    never mutated and never used as live per-user state.
    """

    tg_bot_token: str
    app_mode: str
    enable_real_apply: bool
    browser_backend: str
    browser_headless: bool
    browser_profile_dir: Path
    database_path: Path
    log_path: Path
    check_interval_minutes: int
    max_applications_per_day: int
    max_vacancies_per_query: int
    max_pages_per_query: int
    min_seconds_between_actions: int
    approval_ttl_minutes: int
    captcha_timeout_seconds: int
    captcha_max_attempts: int
    circuit_breaker_min_sample: int
    circuit_breaker_unknown_ratio: float
    circuit_breaker_page_errors: int
    profile: Profile
    # Stage 4\6: immutable snapshot of the default per-user configuration.
    user_defaults: UserSettings


def _path(value: str) -> Path:
    path = Path(value).expanduser()
    return path if path.is_absolute() else BASE_DIR / path


def _strings(section: Mapping[str, object], key: str) -> tuple[str, ...]:
    value = section.get(key, [])
    if not isinstance(value, list) or any(not isinstance(item, str) for item in value):
        raise TypeError(f"{key} must be a list of strings")
    return tuple(item.strip() for item in value if item.strip())


def _text(section: Mapping[str, object], key: str, default: str = "") -> str:
    value = section.get(key, default)
    if not isinstance(value, str):
        raise TypeError(f"{key} must be a string")
    return value.strip()


def _read_env_values(path: Path) -> dict[str, str]:
    """Read a .env file through a handle whose final object was verified."""
    content = read_validated_text(path, kind="configuration file")
    if content is None:
        return {}
    return {
        key: value
        for key, value in dotenv_values(stream=StringIO(content)).items()
        if value is not None
    }


def load_settings(
    env_path: Path | str = BASE_DIR / ".env",
    profile_path: Path | str | None = None,
    environ: Mapping[str, str] | None = None,
) -> Settings:
    values: dict[str, str] = {}
    resolved_env_path = Path(env_path)
    # Even when values come from ``environ``, later protection touches this
    # path with is_file()/protect_config_file().  Validate it before that.
    validate_path_before_io(resolved_env_path, kind="configuration file")
    if environ is None:
        values = _read_env_values(resolved_env_path)
        values.update(os.environ)
    else:
        if resolved_env_path != BASE_DIR / ".env":
            values = _read_env_values(resolved_env_path)
        values.update(environ)
    errors: list[str] = []

    def required(key: str) -> str:
        value = values.get(key, "").strip()
        if not value:
            errors.append(f"{key} is required")
        return value

    def boolean(key: str, default: str) -> bool:
        value = values.get(key, default).strip().lower()
        if value not in {"true", "false"}:
            errors.append(f"{key} must be true or false")
            return False
        return value == "true"

    def positive_integer(key: str, default: str) -> int:
        value = values.get(key, default).strip()
        try:
            parsed = int(value)
        except ValueError:
            errors.append(f"{key} must be an integer")
            return 1
        if parsed <= 0:
            errors.append(f"{key} must be a positive integer")
            return 1
        return parsed

    def non_negative_integer(key: str, default: str) -> int:
        value = values.get(key, default).strip()
        try:
            parsed = int(value)
        except ValueError:
            errors.append(f"{key} must be an integer")
            return 0
        if parsed < 0:
            errors.append(f"{key} must be zero or greater")
            return 0
        return parsed

    def number(key: str, default: str) -> float:
        value = values.get(key, default).strip()
        try:
            parsed = float(value)
        except ValueError:
            errors.append(f"{key} must be a number")
            return 0.0
        if not __import__("math").isfinite(parsed) or not 0 <= parsed <= 2:
            errors.append(f"{key} must be between 0 and 2")
            return 0.0
        return parsed

    def ratio(key: str, default: str) -> float:
        value = values.get(key, default).strip()
        try:
            parsed = float(value)
        except ValueError:
            errors.append(f"{key} must be a number")
            return 1.0
        if not __import__("math").isfinite(parsed) or not 0 < parsed <= 1:
            errors.append(f"{key} must be greater than 0 and at most 1")
            return 1.0
        return parsed

    app_mode = values.get("APP_MODE", "dry_run").strip().lower()
    if app_mode not in {"dry_run", "approval"}:
        errors.append("APP_MODE must be dry_run or approval")

    browser_backend = values.get("BROWSER_BACKEND", "cloakbrowser").strip().lower()
    if browser_backend not in {"cloakbrowser", "playwright"}:
        errors.append("BROWSER_BACKEND must be cloakbrowser or playwright")

    profile_explicitly_loaded = False
    raw_profile: object = {}
    selected_profile: Path | None = None

    if profile_path is not None:
        selected_profile = Path(profile_path)
        content = read_validated_text(selected_profile, kind="configuration file")
        if content is None:
            errors.append(f"profile file not found: {selected_profile}")
        else:
            try:
                raw_profile = yaml.safe_load(content) or {}
                profile_explicitly_loaded = True
            except yaml.YAMLError as exc:
                # Never echo a parser error: YAML messages can quote the
                # offending line, which may contain a secret.
                errors.append(f"cannot read profile: {type(exc).__name__}")
    elif values.get("PROFILE_PATH"):
        selected_profile = _path(values["PROFILE_PATH"])
        content = read_validated_text(selected_profile, kind="configuration file")
        if content is None:
            errors.append(f"profile file not found: {selected_profile}")
        else:
            try:
                raw_profile = yaml.safe_load(content) or {}
                profile_explicitly_loaded = True
            except yaml.YAMLError as exc:
                errors.append(f"cannot read profile: {type(exc).__name__}")
    # else: no profile requested, raw_profile stays empty {}

    # Phase 5.7: secure existing secret-bearing files without changing their
    # format or location.  A protection failure is a configuration error, not
    # a silent success.
    for config_file in (resolved_env_path, selected_profile):
        if config_file is None or not config_file.is_file():
            continue
        try:
            protect_config_file(config_file)
        except (FilesystemProtectionError, OSError) as exc:
            errors.append(
                f"cannot secure configuration file {config_file.name}: "
                f"{type(exc).__name__}"
            )

    if not isinstance(raw_profile, dict):
        errors.append("profile root must be a mapping")
        raw_profile = {}

    def section(name: str) -> Mapping[str, object]:
        value = raw_profile.get(name, {})
        if not isinstance(value, dict):
            errors.append(f"{name} must be a mapping")
            return {}
        return value

    candidate_data = section("candidate")
    hh_data = section("hh")

    try:
        candidate = CandidateProfile(
            name=_text(candidate_data, "name"),
            location=_text(candidate_data, "location"),
            desired_positions=_strings(candidate_data, "desired_positions"),
            experience_summary=_text(candidate_data, "experience_summary"),
            education=_text(candidate_data, "education"),
            technologies=_strings(candidate_data, "technologies"),
            projects=_strings(candidate_data, "projects"),
            github_url=_text(candidate_data, "github_url"),
            salary_expectation=_text(candidate_data, "salary_expectation"),
            work_format=_strings(candidate_data, "work_format"),
            excluded_positions=_strings(candidate_data, "excluded_positions"),
            additional_information=_text(candidate_data, "additional_information"),
        )
        hh = HHProfile(
            resume_name=_text(hh_data, "resume_name"),
            search_queries=_strings(hh_data, "search_queries"),
            areas=_strings(hh_data, "areas"),
            experience_filters=_strings(hh_data, "experience_filters"),
        )
    except TypeError as exc:
        errors.append(str(exc))
        candidate = CandidateProfile("", "", (), "", "", (), (), "", "", (), (), "")
        hh = HHProfile("", (), (), ())

    if profile_explicitly_loaded:
        if not candidate.name:
            errors.append("candidate.name is required")
        if not candidate.desired_positions:
            errors.append("candidate.desired_positions must not be empty")
        if not candidate.experience_summary:
            errors.append("candidate.experience_summary is required")
        if not hh.resume_name:
            errors.append("hh.resume_name is required")
        if not hh.search_queries:
            errors.append("hh.search_queries must not be empty")

    profile = Profile(candidate, hh)

    user_defaults = UserSettings.from_defaults(
        app_mode=app_mode,
        enable_real_apply=boolean("ENABLE_REAL_APPLY", "false"),
        check_interval_minutes=positive_integer("CHECK_INTERVAL_MINUTES", "30"),
        max_applications_per_day=positive_integer("MAX_APPLICATIONS_PER_DAY", "5"),
        approval_ttl_minutes=positive_integer("APPROVAL_TTL_MINUTES", "30"),
        profile=profile,
    )

    settings = Settings(
        tg_bot_token=required("TG_BOT_TOKEN"),
        app_mode=app_mode,
        enable_real_apply=boolean("ENABLE_REAL_APPLY", "false"),
        browser_backend=browser_backend,
        browser_headless=boolean("BROWSER_HEADLESS", "false"),
        browser_profile_dir=_path(values.get("BROWSER_PROFILE_DIR", ".browser-profile")),
        database_path=_path(values.get("DATABASE_PATH", "agent.db")),
        log_path=_path(values.get("LOG_PATH", "agent.log")),
        check_interval_minutes=positive_integer("CHECK_INTERVAL_MINUTES", "30"),
        max_applications_per_day=positive_integer("MAX_APPLICATIONS_PER_DAY", "5"),
        max_vacancies_per_query=positive_integer("MAX_VACANCIES_PER_QUERY", "20"),
        max_pages_per_query=positive_integer("MAX_PAGES_PER_QUERY", "2"),
        min_seconds_between_actions=positive_integer("MIN_SECONDS_BETWEEN_ACTIONS", "5"),
        approval_ttl_minutes=positive_integer("APPROVAL_TTL_MINUTES", "30"),
        captcha_timeout_seconds=positive_integer("CAPTCHA_TIMEOUT_SECONDS", "120"),
        captcha_max_attempts=positive_integer("CAPTCHA_MAX_ATTEMPTS", "2"),
        circuit_breaker_min_sample=positive_integer(
            "CIRCUIT_BREAKER_MIN_SAMPLE", "5"
        ),
        circuit_breaker_unknown_ratio=ratio(
            "CIRCUIT_BREAKER_UNKNOWN_RATIO", "0.8"
        ),
        circuit_breaker_page_errors=positive_integer(
            "CIRCUIT_BREAKER_PAGE_ERRORS", "3"
        ),
        profile=profile,
        user_defaults=user_defaults,
    )
    if errors:
        raise ConfigError("Configuration error:\n- " + "\n- ".join(dict.fromkeys(errors)))
    return settings


def load_user_settings(
    settings: Settings,
    *,
    app_mode: str | None = None,
    enable_real_apply: bool | None = None,
    check_interval_minutes: int | None = None,
    max_applications_per_day: int | None = None,
    approval_ttl_minutes: int | None = None,
    profile: Profile | None = None,
) -> UserSettings:
    """Build an isolated :class:`UserSettings` snapshot for one user.

    Stage 4\6: EVERY call creates a NEW UserSettings object.  The global
    ``settings.user_defaults`` is used only as an immutable bootstrap
    source of default values — it is never returned directly and never
    shared between users::

        a = load_user_settings(settings)
        b = load_user_settings(settings)
        assert a is not b and a == b
    """
    defaults = settings.user_defaults
    return UserSettings(
        app_mode=app_mode if app_mode is not None else defaults.app_mode,
        enable_real_apply=(
            enable_real_apply if enable_real_apply is not None else defaults.enable_real_apply
        ),
        check_interval_minutes=(
            check_interval_minutes
            if check_interval_minutes is not None
            else defaults.check_interval_minutes
        ),
        max_applications_per_day=(
            max_applications_per_day
            if max_applications_per_day is not None
            else defaults.max_applications_per_day
        ),
        approval_ttl_minutes=(
            approval_ttl_minutes
            if approval_ttl_minutes is not None
            else defaults.approval_ttl_minutes
        ),
        profile=profile if profile is not None else defaults.profile,
    )










